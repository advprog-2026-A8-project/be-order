# Runtime
ORDER_APP_PORT=5002
JWT_SECRET=dev-order-jwt-secret-dev-order-jwt-secret-123456

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5003
POSTGRES_DB=orderdb
POSTGRES_DB_DEV=orderdb_dev
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

# External Services
ORDER_INVENTORY_URL=http://localhost:4002/api/products
ORDER_VOUCHER_URL=http://localhost:7002/api/vouchers
ORDER_PROFILE_URL=http://localhost:3002/api/profile

# Internal Service Identity / Auth
ORDER_INVENTORY_INTERNAL_AUTHORIZATION=Bearer <PASTE_JWT_INTERNAL_DARI_BE_AUTHENTICATION>
ORDER_PROFILE_INTERNAL_AUTHORIZATION=Bearer <PASTE_JWT_ADMIN_DARI_BE_AUTHENTICATION>

# Wallet gRPC Contract
ORDER_WALLET_GRPC_HOST=localhost
ORDER_WALLET_GRPC_PORT=9090
GRPC_SERVER_INTERNAL_TOKEN=replace-with-shared-internal-token

# Observability / Actuator
# Set these to enable Prometheus scraping from docker-compose.monitoring.yml
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_PROMETHEUS_ACCESS=none
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=false

# Security / Checkout
ORDER_SECURITY_PRINCIPAL_CLAIM=sub
ORDER_CHECKOUT_LOCK_MODE=postgres-advisory

# Async Rating Sync Worker
ORDER_RATING_SYNC_WORKER_DELAY_MS=3000
ORDER_RATING_SYNC_BATCH_SIZE=20
ORDER_RATING_SYNC_RETRY_MAX_ATTEMPTS=8
ORDER_RATING_SYNC_RETRY_BASE_DELAY_MS=1000

# Async Compensation Worker
ORDER_COMPENSATION_WORKER_DELAY_MS=3000
ORDER_COMPENSATION_BATCH_SIZE=20
ORDER_COMPENSATION_RETRY_MAX_ATTEMPTS=8
ORDER_COMPENSATION_RETRY_BASE_DELAY_MS=1000
ORDER_COMPENSATION_PARALLELISM=4

# Async Admin Summary Materializer
ORDER_SUMMARY_WORKER_DELAY_MS=3000

# Async Checkout Audit Worker
ORDER_AUDIT_WORKER_DELAY_MS=2000
ORDER_AUDIT_BATCH_SIZE=40
ORDER_AUDIT_RETRY_MAX_ATTEMPTS=5
ORDER_AUDIT_RETRY_BASE_DELAY_MS=500
ORDER_AUDIT_PARALLELISM=2
